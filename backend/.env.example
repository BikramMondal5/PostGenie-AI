# AWS Configuration
AWS_REGION=us-east-1

# Groq API Key (for AI content generation fallback)
GROQ_API_KEY=your-groq-api-key-here

# DynamoDB Tables
USERS_TABLE=PostGenie-Users
CONNECTIONS_TABLE=PostGenie-Connections
VOICE_PROFILES_TABLE=PostGenie-VoiceProfiles
MODELS_TABLE=PostGenie-Models
POSTS_TABLE=PostGenie-Posts

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# OAuth Secrets (stored in AWS Secrets Manager)
OAUTH_SECRETS_NAME=PostGenie/OAuth
